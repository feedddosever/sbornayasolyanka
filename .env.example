########################################################################
# Factor — environment
#
# Three chains, on purpose. The browser wallet only ever touches Fuji;
# Arkiv writes use in-app signers and ENS setup is a pre-run script, so a
# judge is never asked to switch networks mid-demo.
########################################################################

# ---------------------------------------------------------------- Avalanche Fuji (43113)
# Deployer / platform owner. Needs test AVAX:
#   https://core.app/tools/testnet-faucet/   (needs mainnet AVAX balance OR a
#   coupon from https://guild.xyz/avalanche — 2 AVAX per address per 24h)
PRIVATE_KEY=0x

# Demo cast. Set these before running the deploy script so everyone is
# onboarded and funded in one transaction.
ISSUER_ADDR=0x
DEBTOR_ADDR=0x
FIN1_ADDR=0x
FIN2_ADDR=0x

# Filled in by `npm run contracts:deploy`
NEXT_PUBLIC_CLAIM_ADDRESS=0x
NEXT_PUBLIC_FUSD_ADDRESS=0x

# The financiers the demo bid buttons stand a bid for. MUST be distinct from
# ISSUER_ADDR: `sell()` reverts with SelfPurchase when buyer == holder, and the
# issuer is the holder right after issue(). Same values as FIN1/FIN2 above.
NEXT_PUBLIC_FIN1_ADDR=0x
NEXT_PUBLIC_FIN2_ADDR=0x

# For `forge verify-contract` — https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=

# ---------------------------------------------------------------- Arkiv (Tiramisu, 7738577)
# ONE GLM-funded key from the faucet at hub.arkiv.network is ENOUGH.
#
# Set ARKIV_FIN1_PK and leave the other two blank if you only have one wallet:
# both API routes fall back to it. Whose bid a row belongs to comes from the
# `financier` ATTRIBUTE, not from `$owner` — the signer is Factor's key either
# way, because keys stay server-side. See the ownership section in
# arkiv/schema.md.
#
# Extra keys only spread writes across signers; they do not change any query.
ARKIV_FIN1_PK=0x
ARKIV_ISSUER_PK=
ARKIV_FIN2_PK=

# Optional but strongly recommended once deployed: raises the RPC rate limit.
# hub.arkiv.network/api-keys -> connect wallet, pick Tiramisu, generate.
# Without it a public demo polling the bid book will start getting throttled.
ARKIV_API_KEY=

# Invoice id the evidence script posts bids against
EVIDENCE_INVOICE_ID=1

# ---------------------------------------------------------------- ENSv2 (Sepolia, 11155111)
# Needs Sepolia ETH *and* MockUSDC — the ETHRegistrar charges in MockUSDC
# (0x768F42455A2D082E23ceeF7d51e5787C82d67a39), not ETH.
SEPOLIA_PK=0x
SEPOLIA_RPC=
NEXT_PUBLIC_SEPOLIA_RPC=

# The .eth name you control; businesses become <label>.<this>.eth
ENS_PARENT_LABEL=factor
ENS_BUSINESSES=acme,northwind

# Written back by scripts/ens-setup.ts — set them to skip redeploying proxies
ENS_USER_REGISTRY=
ENS_RESOLVER=

# The wallet that gets ONE delegated text key, for the permission demo
ENS_ACCOUNTANT_ADDR=0x

# ---------------------------------------------------------------- Swarm
# Optional: a gateway that absorbs storage cost, so users with no postage
# batch still get canUpload === true. Leave blank if the gift code gives
# end users their own stamp.
NEXT_PUBLIC_SWARM_SUBSIDISED_GATEWAY=
